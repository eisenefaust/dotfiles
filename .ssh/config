# Read more about SSH config files: https://linux.die.net/man/5/ssh_config
# Host alias
#     HostName hostname
#     User user
# ssh-keygen -f ~/.ssh/host_ed25519 -t ed25519
# ssh-copy-id -i ~/.ssh/host_ed25519 user@host

# for ghostty and tmux per host
# https://ghostty.org/docs/help/terminfo
# infocmp -x xterm-ghostty | ssh sasquatch -- tic -x -
#   N.B. need to do this per user I want to access on the host as well. 
#       easiest is ssh user@<host_FQDN>
#       e.g. infocmp -x xterm-ghostty | ssh de-gmorto@login-2.hpc.childrens.sea.kids -- tic -x -

Host sasquatch
    HostName login-2.hpc.childrens.sea.kids
    User gmorto
    Port 22
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/sasquatch_ed25519

Host sasquatch-1
    HostName login-1.hpc.childrens.sea.kids
    User gmorto
    Port 22
    PreferredAuthentications publickey
