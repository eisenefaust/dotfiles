# Load dotfiles:
for file in ~/.{bash_prompt,aliases}; do
    # check if file is readable and a normal file before loading
    [ -r "$file" ] && [ -f "$file" ] && source "$file"
done
unset file

# history setup 
# from: https://askubuntu.com/a/667787
# and: https://unix.stackexchange.com/a/18443
# and: https://datawookie.dev/blog/2023/04/configuring-bash-history/
# export HISTFILE=$HOME/.bash_history
export HISTSIZE=5000 # max commands that are saved in memory
export HISTFILESIZE=5000 # max lines of history file
export HISTTIMEFORMAT='%F %T - '
export HISTCONTROL=ignoredups:erasedups
export HISTIGNORE="clear:history:[bf]g:exit:date"
shopt -s histappend
# ${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}
# Append to the history file and reread it
# history -a: appends the new history lines (from this session) to the history file.
# history -n: reads the new history lines (from other sessions) from the history file.
export PROMPT_COMMAND="history -a; history -n; $PROMPT_COMMAND"

eval "$(pixi completion --shell bash)"
