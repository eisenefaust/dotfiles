# Load dotfiles:
for file in ~/.{bash_prompt,aliases}; do
    # check if file is readable and a normal file before loading
    [ -r "$file" ] && [ -f "$file" ] && source "$file"
done
unset file

# history setup 
# from: https://askubuntu.com/a/667787
# and: https://unix.stackexchange.com/a/18443
# and: https://datawookie.dev/blog/2023/04/configuring-bash-history/
# export HISTFILE=$HOME/.bash_history
export HISTSIZE=5000 # max commands that are saved in memory
export HISTFILESIZE=5000 # max lines of history file
export HISTTIMEFORMAT='%F %T - '
export HISTCONTROL=ignoredups:erasedups # ignore consecutive duplicates and erase older duplicates
export HISTIGNORE="clear:history:[bf]g:exit:date" # commands to ignore
shopt -s histappend

# Sync history across sessions and remove duplicates.
# 1. `history -a`: Append this session's history to the file.
# 2. `history -n`: Read history from other sessions into this session's memory.
# 3. `awk ...`: De-duplicate the history file in place.
# 4. `history -c; history -r`: Clear and re-read the de-duplicated history into memory.
export PROMPT_COMMAND="history -a; history -n; awk -i inplace '!seen[\$0]++' \"\$HISTFILE\"; history -c; history -r; $PROMPT_COMMAND"

eval "$(pixi completion --shell bash)"
